[Unit]
Description=Retail IMS PostgreSQL full backup (physical + logical)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/retail-ims/postgres-backup.env
ExecStart=/opt/retail-ims/postgres-backup/scripts/pg-full-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
