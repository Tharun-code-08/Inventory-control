# Copy to /etc/retail-ims/postgres-backup.env on the VPS and adjust values.
# chmod 600 /etc/retail-ims/postgres-backup.env

# PostgreSQL connection (used by pg_dump / pg_basebackup)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
# Set PGPASSWORD here OR use a ~/.pgpass file (recommended).
# PGPASSWORD=

# Application database name (from DATABASE_URL)
PGDATABASE=retail_ims

# Local backup root (needs postgres write access for WAL archive subdir)
BACKUP_ROOT=/var/backups/postgres

# Subdirectories (created by install script)
FULL_DIR=${BACKUP_ROOT}/full
LOGICAL_DIR=${BACKUP_ROOT}/logical
WAL_DIR=${BACKUP_ROOT}/wal
LOG_DIR=${BACKUP_ROOT}/logs

# Retention (days)
RETENTION_FULL_DAYS=14
RETENTION_LOGICAL_DAYS=30
RETENTION_WAL_DAYS=14

# Optional offsite sync (leave empty to skip)
# Examples:
#   RSYNC_TARGET=backup@vps-backup.example.com:/backups/retail-ims/postgres
#   S3_BUCKET=s3://my-bucket/retail-ims/postgres
RSYNC_TARGET=
S3_BUCKET=
S3_ENDPOINT=
AWS_PROFILE=

# Alert hook (optional). Receives one argument: error message.
# ALERT_CMD=/usr/local/bin/notify-backup-failure.sh
