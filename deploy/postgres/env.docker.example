#!/usr/bin/env bash
# Copy to /etc/retail-ims/postgres-backup.env and adjust values for your VPS.
# chmod 600 /etc/retail-ims/postgres-backup.env

# Docker container running PostgreSQL
DOCKER_CONTAINER=docker-postgres-1

# Postgres credentials (inside the container)
PGUSER=retail
PGPASSWORD=retail
PGDATABASE=retail_ims
PGHOST=127.0.0.1
PGPORT=5432

# Local backup root on the host
BACKUP_ROOT=/var/backups/postgres
FULL_DIR=${BACKUP_ROOT}/full
COMPANY_DIR=${BACKUP_ROOT}/companies
LOG_DIR=${BACKUP_ROOT}/logs

# Retention (days) for both full and company-scoped dumps
RETENTION_DAYS=30

# Optional offsite sync (not enabled by default)
# RSYNC_TARGET=backup@backup-server:/backups/retail-ims/postgres
# S3_BUCKET=s3://my-bucket/retail-ims/postgres
# S3_ENDPOINT=https://s3.example.com
# AWS_PROFILE=backup

# Optional alert hook (receives one argument: error message)
# ALERT_CMD=/usr/local/bin/notify-backup-failure.sh
