{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "build:full": "prisma generate && nest build",
    "prisma:generate": "prisma generate",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma": "prisma",
    "db:seed": "prisma db seed",
    "db:purge-test-data": "ts-node --transpile-only prisma/purge-test-data.ts",
    "verify:inventory": "ts-node --transpile-only scripts/verify-inventory.ts",
    "test": "jest --config ./jest.config.js",
    "test:watch": "jest --config ./jest.config.js --watch",
    "test:cov": "jest --config ./jest.config.js --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:workflows": "jest --config ./test/jest-e2e.json --testPathPattern test/workflows --runInBand --forceExit",
    "test:e2e:concurrent-gr": "jest --config ./test/jest-e2e.json --testPathPattern phase2-concurrent-gr --runInBand",
    "verify:smtp": "node scripts/verify-smtp.cjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1072.0",
    "@aws-sdk/s3-request-presigner": "^3.1072.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^10.51.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.0",
    "joi": "^18.3.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.2",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^25.14.0",
    "puppeteer-cluster": "^0.25.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "undici": "^8.12.2",
    "uuid": "^11.1.0"
