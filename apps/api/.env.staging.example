# STAGING ENVIRONMENT - COMPLETELY SEPARATE FROM PRODUCTION
# DO NOT MIX PRODUCTION SECRETS HERE

# Node & API Configuration
NODE_ENV=staging
API_PORT=3001
API_HOST=0.0.0.0

# Database - STAGING DATABASE ONLY
DATABASE_URL=postgresql://retail:retail@127.0.0.1:5433/staging_retail_ims

# JWT & Security - STAGING-SPECIFIC (Different from production)
JWT_SECRET=staging_jwt_secret_32chars_random_98765432109876
REFRESH_SECRET=staging_refresh_secret_32chars_random_abcdefghijk
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
REFRESH_COOKIE_NAME=refreshToken
COOKIE_SECRET=staging_cookie_secret_32chars_random_wxyzabcdef

# Redis - STAGING INSTANCE (port 6380, DB 1, separate from production)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=1
REDIS_PREFIX=staging:

# Storage
EXPORT_STORAGE_DIR=./storage/exports
UPLOAD_STORAGE_DIR=./storage/uploads

# Web Frontend
VITE_API_URL=http://erp-softdigit.tech/api/v1

# Email - MAILTRAP SANDBOX (does NOT send real emails)
# Emails go to Mailtrap inbox, not actual inboxes
# Never use production email config here
MAIL_FROM=noreply@staging.retailims.test
MAIL_REPLY_TO=staging@retailims.test
ADMIN_NOTIFICATION_EMAIL=staging-admin@retailims.test
PUBLIC_WEB_URL=http://erp-softdigit.tech

# Mailtrap for sandbox email testing
SMTP_HOST=send.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=true
SMTP_USER=stagingmailtrapuser
SMTP_PASS=stagingmailtrappass

# User Invitations
INVITE_TTL_HOURS=72
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Razorpay TEST KEYS ONLY
# ⚠️  CRITICAL: rzp_test_* not rzp_live_*
# Using test keys ensures staging never charges real customers
# TODO: Replace with actual Razorpay test account credentials from https://dashboard.razorpay.com
# Step 1: Create Razorpay account (https://razorpay.com)
# Step 2: Switch to Test mode in dashboard
# Step 3: Copy Key ID and Secret from Settings → API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_ACTUAL_TEST_KEY_HERE
RAZORPAY_KEY_ID=rzp_test_YOUR_ACTUAL_TEST_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_ACTUAL_TEST_SECRET_HERE

# Billing - Staging Demo Price
BILLING_DEMO_PLUS_PRICE_INR=1

# CORS Origins - Staging ONLY
WEB_ORIGIN=http://erp-softdigit.tech,https://erp-softdigit.tech,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=info
NODE_OPTIONS=--max-old-space-size=2048

# ============================================================
# SAFETY CHECKLIST - VERIFY BEFORE DEPLOYMENT
# ============================================================
# ✅ DATABASE_URL must point to staging_retail_ims
# ✅ RAZORPAY_KEY_ID must start with rzp_test_ NOT rzp_live_
# ✅ SMTP_HOST must be Mailtrap (sandbox) NOT production SMTP
# ✅ REDIS_PORT must be 6380 (staging) NOT 6379 (production)
# ✅ JWT_SECRET must be DIFFERENT from production
# ✅ WEB_ORIGIN must be staging domains ONLY
#
# IF PRODUCTION KEYS ARE USED HERE:
#   - Real customers could be charged
#   - Production data could be corrupted
#   - Production emails could be sent from staging
# ============================================================
