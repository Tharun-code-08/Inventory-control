generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  OWNER
  ADMIN
  INVENTORY_MANAGER
  PURCHASE_MANAGER
  SALES
  EMPLOYEE
  WAREHOUSE_STAFF
  VIEWER
  VENDOR
  SHOP_USER
}

enum DocumentStatus {
  DRAFT
  POSTED
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum TransactionType {
  OPENING
  GOODS_RECEIPT
  GOODS_ISSUE
  DAMAGE
  ADJUSTMENT
  STOCK_TRANSFER_OUT
  STOCK_TRANSFER_IN
}

enum ReceiptType {
  FULL
  PARTIAL
}

enum ReceiptSource {
  PURCHASE_ORDER
  OUTSIDE
}

enum InwardShift {
  DAY_SHIFT
  NIGHT_SHIFT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  POST
  EXPORT
  EMAIL
}

enum CostingMethod {
  AVERAGE
  FIFO
}

enum TaxPreference {
  TAXABLE
  NON_TAXABLE
}

enum FulfillmentStatus {
  NONE
  PARTIAL
  FULL
}

enum GstSupplyType {
  INTRA_STATE
  INTER_STATE
}

enum ReturnStatus {
  DRAFT
  POSTED
  SUBMITTED
  ACKNOWLEDGED
  DONE
  CANCELLED
}

enum SupplierReturnReasonCode {
  DAMAGED
  WRONG_ITEM
  EXPIRED
  EXCESS
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  VOID
}

enum SubscriptionPlan {
  TRIAL
  PRO
  PLUS
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum LifecycleStage {
  NEW
  ACTIVE
  ENGAGED
  AT_RISK
  RENEWAL_DUE
  EXPIRED
  TRIAL
  TRIAL_EXPIRED
}

enum LifecycleCampaignStatus {
  SCHEDULED
  SENT
  SKIPPED
  FAILED
}

enum PlatformNotificationCategory {
  REVENUE
  HEALTH
  SYSTEM
}

enum PlatformNotificationSeverity {
  CRITICAL
  HIGH
  WARNING
  INFO
}

enum PasswordResetMethod {
  OTP
  MAGIC_LINK
}

enum MfaMethod {
  TOTP
}

enum AuthChallengePurpose {
  SIGNUP_MFA_ENROLL
  LOGIN_MFA_VERIFY
}

enum EmailSenderType {
  CUSTOM_DOMAIN
  PUBLIC_DOMAIN
}

enum EmailSenderStatus {
  PENDING
  VERIFIED
  FAILED
}

enum BrandingMode {
  LIVE
  SNAPSHOT
}

enum MediaAssetType {
  LOGO
  STAMP
  SIGNATURE
  LETTERHEAD
  WATERMARK
}

model Company {
  id                 String             @id @default(uuid()) @db.Uuid
  companyCode        String             @unique @map("company_code")
  companyName        String             @map("company_name")
  address            String?
  brandingProfileId  String?            @map("branding_profile_id") @db.Uuid
  isActive           Boolean            @default(true) @map("is_active")
  subscriptionPlan   SubscriptionPlan   @default(TRIAL) @map("subscription_plan")
  billingCycle       BillingCycle?      @map("billing_cycle")
  subscriptionStatus SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  trialStartsAt      DateTime?          @map("trial_starts_at") @db.Timestamptz(6)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  subscriptionEndsAt DateTime?          @map("subscription_ends_at") @db.Timestamptz(6)
  platformMarketingOptOut Boolean       @default(false) @map("platform_marketing_opt_out")
  razorpaySubscriptionId String?        @map("razorpay_subscription_id")
  paidActivatedAt    DateTime?          @map("paid_activated_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById        String?            @map("created_by") @db.Uuid
  updatedById        String?            @map("updated_by") @db.Uuid

  brandingProfile     BrandingProfile?       @relation("CompanyBrandingProfile", fields: [brandingProfileId], references: [id])
  shops                Shop[]
  suppliers            Supplier[]
  subscriptionPayments SubscriptionPayment[]
  subscriptionInvoices SubscriptionInvoice[]
  engagementSnapshots  CompanyEngagementSnapshot[]
  lifecycleCampaigns   LifecycleCampaignEnrollment[]
  backupProviderCredentials BackupProviderCredential[]
  backupJobs           BackupJob[]
  backupArtifacts      BackupArtifact[]
  restoreJobs          RestoreJob[]
  documentSeriesConfigs DocumentSeriesConfig[]
  emailSenderDomains    EmailSenderDomain[]
  emailSenderIdentities EmailSenderIdentity[]
  mediaAssets           MediaAsset[]

  @@map("companies")
}

model BrandingProfile {
  id              String   @id @default(uuid()) @db.Uuid
  brandingVersion Int      @default(1) @map("branding_version")
  logoAssetId     String?  @map("logo_asset_id") @db.Uuid
  watermarkAssetId String? @map("watermark_asset_id") @db.Uuid
  sealAssetId     String?  @map("seal_asset_id") @db.Uuid
  signatureAssetId String? @map("signature_asset_id") @db.Uuid
  letterheadAssetId String? @map("letterhead_asset_id") @db.Uuid
  footerText      String?  @map("footer_text")
  email           String?  @map("email")
  phone           String?  @map("phone")
  website         String?  @map("website")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById     String?  @map("created_by") @db.Uuid
  updatedById     String?  @map("updated_by") @db.Uuid

  companyOwners Company[] @relation("CompanyBrandingProfile")
  shopOwners    Shop[]    @relation("ShopBrandingProfile")
  logoAsset     MediaAsset? @relation("LogoAsset", fields: [logoAssetId], references: [id])
  watermarkAsset MediaAsset? @relation("WatermarkAsset", fields: [watermarkAssetId], references: [id])
  sealAsset      MediaAsset? @relation("SealAsset", fields: [sealAssetId], references: [id])
  signatureAsset MediaAsset? @relation("SignatureAsset", fields: [signatureAssetId], references: [id])
  letterheadAsset MediaAsset? @relation("LetterheadAsset", fields: [letterheadAssetId], references: [id])
  mediaAssets     MediaAsset[] @relation("ProfileMediaAssets")

  @@map("branding_profiles")
}

model MediaAsset {
  id                String         @id @default(uuid()) @db.Uuid
  companyId         String?        @map("company_id") @db.Uuid
  shopId            String?        @map("shop_id") @db.Uuid
  brandingProfileId String?        @map("branding_profile_id") @db.Uuid
  type              MediaAssetType @map("type")
  assetKey          String         @map("asset_key")
  fileName          String         @map("file_name")
  version           Int            @default(1)
  metadata          Json?          @map("metadata")
  uploadedById      String?        @map("uploaded_by") @db.Uuid
  uploadedAt        DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  active            Boolean        @default(true)

  company          Company?         @relation(fields: [companyId], references: [id])
  shop             Shop?            @relation(fields: [shopId], references: [id])
  brandingProfile  BrandingProfile? @relation("ProfileMediaAssets", fields: [brandingProfileId], references: [id])
  logoProfiles      BrandingProfile[] @relation("LogoAsset")
  watermarkProfiles BrandingProfile[] @relation("WatermarkAsset")
  sealProfiles      BrandingProfile[] @relation("SealAsset")
  signatureProfiles BrandingProfile[] @relation("SignatureAsset")
  letterheadProfiles BrandingProfile[] @relation("LetterheadAsset")

  @@index([companyId])
  @@index([shopId])
  @@index([brandingProfileId])
  @@index([type, active])
  @@map("media_assets")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        RoleName         @unique
  permissions Json             @default("[]")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?          @map("created_by") @db.Uuid
  updatedById String?          @map("updated_by") @db.Uuid
  users       User[]
  invitations UserInvitation[]

  @@map("roles")
}

model Shop {
  id                 String        @id @default(uuid()) @db.Uuid
  shopNumber         String        @unique @map("shop_number")
  shopName           String        @map("shop_name")
  taxId              String?       @map("tax_id")
  address            String
  contactPerson      String        @map("contact_person")
  mobile             String
  email              String
  companyId          String?       @map("company_id") @db.Uuid
  brandingProfileId  String?       @map("branding_profile_id") @db.Uuid
  isActive           Boolean       @default(true) @map("is_active")
  costingMethod      CostingMethod @default(AVERAGE) @map("costing_method")
  functionalCurrency String        @default("USD") @map("functional_currency")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById        String?       @map("created_by") @db.Uuid
  updatedById        String?       @map("updated_by") @db.Uuid

  company            Company?                  @relation(fields: [companyId], references: [id])
  brandingProfile    BrandingProfile?          @relation("ShopBrandingProfile", fields: [brandingProfileId], references: [id])
  users              User[]
  invitations        UserInvitation[]
  productPlants      ProductPlant[]
  goodsReceipts      GoodsReceiptHeader[]
  goodsIssues        GoodsIssueHeader[]
  damagedStocks      DamagedStock[]
  purchaseOrders     PurchaseOrderHeader[]
  stockLedgers       StockLedger[]
  stockSummaries     StockSummary[]
  documentSequences  DocumentSequence[]
  storageLocations   StorageLocation[]
  rfqs               RfqHeader[]
  contracts          ContractHeader[]
  supplierQuotations SupplierQuotationHeader[]
  customers          Customer[]
  salesOrders        SalesOrderHeader[]
  salesQuotations    SalesQuotationHeader[]
  invoiceHeaders     InvoiceHeader[]
  paymentReceipts    PaymentReceipt[]
  alertEvents        AlertEvent[]
  costLayers         CostLayer[]
  customerReturns    CustomerReturn[]
  supplierReturns    SupplierReturn[]
  creditNotes        CreditNote[]
  supplierBills      SupplierBillHeader[]
  supplierPayments   SupplierPayment[]
  stockTransfersFrom StockTransferHeader[] @relation("StockTransferFromShop")
  stockTransfersTo   StockTransferHeader[] @relation("StockTransferToShop")
  documentSeriesConfigs DocumentSeriesConfig[]
  mediaAssets         MediaAsset[]

  @@map("shops")
}

model StorageLocation {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  code        String   @map("code")
  name        String   @map("name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  shop              Shop               @relation(fields: [shopId], references: [id])
  productPlants     ProductPlant[]
  goodsReceiptItems GoodsReceiptItem[]
  stockTransfersFrom StockTransferHeader[] @relation("StockTransferFromLocation")
  stockTransfersTo   StockTransferHeader[] @relation("StockTransferToLocation")

  @@unique([shopId, code])
  @@index([shopId, code])
  @@map("storage_locations")
}

model SignupVerification {
  id           String    @id @default(uuid()) @db.Uuid
  email        String
  payload      Json
  otpHash      String    @map("otp_hash")
  sessionTokenHash  String?   @map("session_token_hash")
  totpSecretEncrypted String? @map("totp_secret_encrypted")
  attemptCount Int       @default(0) @map("attempt_count")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@index([sessionTokenHash])
  @@index([expiresAt])
  @@map("signup_verifications")
}

model SubscriptionPayment {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String?          @map("company_id") @db.Uuid
  plan              SubscriptionPlan
  billingCycle      BillingCycle     @map("billing_cycle")
  amountPaise       Int              @map("amount_paise")
  currency          String           @default("INR")
  razorpayOrderId   String           @unique @map("razorpay_order_id")
  razorpayPaymentId String?          @unique @map("razorpay_payment_id")
  status            String           @default("pending")
  verifiedAt        DateTime?        @map("verified_at") @db.Timestamptz(6)
  consumedAt        DateTime?        @map("consumed_at") @db.Timestamptz(6)
  invoiceId         String?          @map("invoice_id") @db.Uuid
  failureReason     String?          @map("failure_reason")
  renewalAttempt    Int              @default(0) @map("renewal_attempt")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  invoice SubscriptionInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([invoiceId])
  @@map("subscription_payments")
}

model SubscriptionInvoice {
  id                     String           @id @default(uuid()) @db.Uuid
  invoiceNumber          String           @unique @map("invoice_number")
  companyId              String           @map("company_id") @db.Uuid
  plan                   SubscriptionPlan
  billingCycle           BillingCycle     @map("billing_cycle")
  amountPaise            Int              @map("amount_paise")
  taxPaise               Int              @default(0) @map("tax_paise")
  totalPaise             Int              @map("total_paise")
  currency               String           @default("INR")
  gstNumber              String?          @map("gst_number")
  billingAddressSnapshot Json?            @map("billing_address_snapshot")
  issuedAt               DateTime         @default(now()) @map("issued_at") @db.Timestamptz(6)
  pdfStorageKey          String?          @map("pdf_storage_key")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments SubscriptionPayment[]

  @@index([companyId])
  @@index([issuedAt])
  @@map("subscription_invoices")
}

model CompanyEngagementSnapshot {
  id                  String          @id @default(uuid()) @db.Uuid
  companyId           String          @map("company_id") @db.Uuid
  snapshotDate        DateTime        @map("snapshot_date") @db.Date
  lifecycleStage      LifecycleStage  @map("lifecycle_stage")
  lastLoginAt         DateTime?       @map("last_login_at") @db.Timestamptz(6)
  loginCount30d       Int             @default(0) @map("login_count_30d")
  featuresUsed        Json            @default("{}") @map("features_used")
  productsCount       Int             @default(0) @map("products_count")
  inventoryTxnCount   Int             @default(0) @map("inventory_txn_count")
  teamMembersCount    Int             @default(0) @map("team_members_count")
  reportsGenerated    Int             @default(0) @map("reports_generated")
  trialProgressPct    Int             @default(0) @map("trial_progress_pct")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, snapshotDate])
  @@index([snapshotDate])
  @@index([lifecycleStage])
  @@map("company_engagement_snapshots")
}

model LifecycleCampaignEnrollment {
  id                String                  @id @default(uuid()) @db.Uuid
  companyId         String                  @map("company_id") @db.Uuid
  campaignKey       String                  @map("campaign_key")
  scheduledFor      DateTime?               @map("scheduled_for") @db.Timestamptz(6)
  sentAt            DateTime?               @map("sent_at") @db.Timestamptz(6)
  status            LifecycleCampaignStatus @default(SCHEDULED)
  emailDeliveryLogId String?                @map("email_delivery_log_id") @db.Uuid
  metadata          Json?
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, campaignKey])
  @@index([campaignKey])
  @@index([status])
  @@index([scheduledFor])
  @@map("lifecycle_campaign_enrollments")
}

model UserInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  name        String?
  roleId      String    @map("role_id") @db.Uuid
  shopId      String?   @map("shop_id") @db.Uuid
  tokenHash   String    @map("token_hash")
  invitedById String    @map("invited_by") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  role      Role  @relation(fields: [roleId], references: [id])
  shop      Shop? @relation(fields: [shopId], references: [id])
  invitedBy User  @relation("UserInvitationsSent", fields: [invitedById], references: [id])

  @@index([email])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("user_invitations")
}

model PasswordResetRequest {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  email            String
  method           PasswordResetMethod
  otpHash          String?             @map("otp_hash")
  linkTokenHash    String?             @map("link_token_hash")
  attemptCount     Int                 @default(0) @map("attempt_count")
  expiresAt        DateTime            @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime?           @map("consumed_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSentAt       DateTime?           @map("last_sent_at") @db.Timestamptz(6)
  requestedIp      String?             @map("requested_ip")
  requestedUserAgent String?           @map("requested_user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([linkTokenHash])
  @@index([expiresAt])
  @@map("password_reset_requests")
}

model AuthChallenge {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  purpose             AuthChallengePurpose
  tokenHash           String               @map("token_hash")
  totpSecretEncrypted String?              @map("totp_secret_encrypted")
  attemptCount        Int                  @default(0) @map("attempt_count")
  expiresAt           DateTime             @map("expires_at") @db.Timestamptz(6)
  consumedAt          DateTime?            @map("consumed_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  requestedIp         String?              @map("requested_ip")
  requestedUserAgent  String?              @map("requested_user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model UserBackupCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash")
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@map("user_backup_codes")
}

model TrustedMfaDevice {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  ip         String?
  userAgent  String?   @map("user_agent")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, revokedAt])
  @@map("trusted_mfa_devices")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  email              String    @unique
  passwordHash       String    @map("password_hash")
  avatarUrl          String?   @map("avatar_url")
  roleId             String    @map("role_id") @db.Uuid
  shopId             String?   @map("shop_id") @db.Uuid
  isActive           Boolean   @default(true) @map("is_active")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  mfaMethod          MfaMethod? @map("mfa_method")
  mfaEnrolledAt      DateTime? @map("mfa_enrolled_at") @db.Timestamptz(6)
  mfaSecretEncrypted String?   @map("mfa_secret_encrypted")
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(6)
  refreshTokenHash   String?   @map("refresh_token_hash")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById        String?   @map("created_by") @db.Uuid
  updatedById        String?   @map("updated_by") @db.Uuid

  role            Role             @relation(fields: [roleId], references: [id])
  shop            Shop?            @relation(fields: [shopId], references: [id])
  sentInvitations UserInvitation[] @relation("UserInvitationsSent")
  reportSavedFilters ReportSavedFilter[]

  auditLogs             AuditLog[]
  sessions              Session[]
  passwordResetRequests PasswordResetRequest[]
  authChallenges        AuthChallenge[]
  backupCodes           UserBackupCode[]
  trustedMfaDevices     TrustedMfaDevice[]

  @@index([deletedAt])
  @@map("users")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  refreshHash String    @map("refresh_hash")
  ip          String?
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model ReportSavedFilter {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  reportType String   @map("report_type")
  name       String
  filterJson Json     @map("filter_json")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reportType])
  @@map("report_saved_filters")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  productCode      String        @unique @map("product_code")
  description      String
  uom              String
  category         String
  hsnCode          String?       @map("hsn_code")
  materialGroup    String?       @map("material_group")
  drawingReference String?       @map("drawing_reference")
  brand            String?
  taxPreference    TaxPreference @default(TAXABLE) @map("tax_preference")
