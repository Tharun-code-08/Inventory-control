  @@index([shopId, resolvedAt])
  @@index([productId, createdAt])
  @@map("low_stock_alerts")
}

// ============================================
// DOCUMENT GENERATION & PDF SYSTEM
// ============================================

model DocumentRegistry {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  documentType     String    @map("document_type")
  referenceId      String?   @map("reference_id") @db.Uuid // Optional: for report-type PDFs without single entity
  templateVersion  String    @default("1.0") @map("template_version")

  storageKey       String    @map("storage_key")
  storageProvider  String    @default("local") @map("storage_provider")
  fileSizeBytes    BigInt?   @map("file_size_bytes")
  checksum         String?
  mimeType         String    @default("application/pdf") @map("mime_type") // application/pdf, image/png, text/csv, etc

  jobId            String?   @map("job_id")
  status           String    @default("pending")  // pending, processing, completed, failed, expired

  metadata         Json?                           // For storing contextual data (warehouseId, categoryId, filters, etc)
  generatedBy      String?   @map("generated_by") @db.Uuid
  generatedAt      DateTime  @default(now()) @map("generated_at") @db.Timestamptz(6)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)

  downloadCount    Int       @default(0) @map("download_count")
  lastDownloadedAt DateTime? @map("last_downloaded_at") @db.Timestamptz(6)

  renderDurationMs Int?      @map("render_duration_ms")    // PDF rendering time in milliseconds
  renderedAt       DateTime? @map("rendered_at") @db.Timestamptz(6)
  storageLatencyMs Int?      @map("storage_latency_ms")    // Storage upload time in milliseconds

  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentType])
  @@index([referenceId])
  @@index([status])
  @@index([jobId])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([tenantId, documentType, referenceId, templateVersion, status]) // Cache lookup
  @@index([renderDurationMs])
  @@index([renderedAt])
  @@map("document_registry")
}

model PdfJob {
  id          String    @id
  tenantId    String    @map("tenant_id") @db.Uuid
  documentId  String?   @map("document_id") @db.Uuid
  jobType     String    @map("job_type")
  status      String
  progress    Int       @default(0)
  result      Json?
  errorMessage String?  @map("error_message") @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  company Company @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("pdf_jobs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Agent Platform (Phase 1) — WhatsApp channel, secure linking, conversations,
// AI settings/usage. WhatsApp is the first ChannelAdapter; the schema is
// channel-agnostic so Telegram/Slack/web-chat slot in later.
// ─────────────────────────────────────────────────────────────────────────────

enum ChatChannel {
  WHATSAPP
}

enum ChannelAccountStatus {
  ACTIVE
  DISABLED
}

enum ChannelLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum ConversationStatus {
  ACTIVE
  AWAITING_CONFIRMATION
  AWAITING_APPROVAL
  HANDOFF
  CLOSED
}

enum MessageDirection {
  IN
  OUT
}

enum ChatMessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum AiModelRole {
  INTENT
  REASONING
  ESCALATION
}

/// A channel account we can send/receive through. `companyId = null` is the
/// shared platform account (MVP); a tenant-owned WABA sets `companyId` (later).
model ChannelAccount {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String?              @map("company_id") @db.Uuid
  channel           ChatChannel          @default(WHATSAPP)
  provider          String               @default("meta")
  businessAccountId String?              @map("business_account_id")
  phoneNumberId     String               @map("phone_number_id")
  displayPhone      String?              @map("display_phone")
  /// Encrypted via common/crypto/secret-cipher.ts (never plaintext).
  accessToken       String?              @map("access_token")
  /// Encrypted; HMAC app secret for webhook signature verification.
  webhookSecret     String?              @map("webhook_secret")
  status            ChannelAccountStatus @default(ACTIVE)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([channel, phoneNumberId])
  @@index([companyId])
  @@map("channel_accounts")
}

/// Verified binding of an ERP user to a channel identity (phone number).
model UserChannelLink {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  companyId   String            @map("company_id") @db.Uuid
  channel     ChatChannel       @default(WHATSAPP)
  /// E.164 without "+", as Meta sends it (e.g. "9198xxxxxxxx").
  phoneNumber String            @map("phone_number")
  status      ChannelLinkStatus @default(PENDING)
  verifiedAt  DateTime?         @map("verified_at") @db.Timestamptz(6)
  lastSeenAt  DateTime?         @map("last_seen_at") @db.Timestamptz(6)
  /// Per-user preferences (notification opt-ins, etc.). Schema: { notifPrefs?: { dailySummary?: bool, lowStock?: bool, overduePayment?: bool } }
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([channel, phoneNumber])
  @@index([userId])
  @@index([companyId])
  @@map("user_channel_links")
}

/// OTP challenge for linking a WhatsApp number (mirrors SignupVerification).
model WhatsAppVerification {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  phoneNumber  String    @map("phone_number")
  otpHash      String    @map("otp_hash")
  attemptCount Int       @default(0) @map("attempt_count")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([phoneNumber])
  @@index([expiresAt])
  @@map("whatsapp_verifications")
}

enum LinkTokenStatus {
  ACTIVE
  USED
  EXPIRED
}

enum WhatsAppDeviceStatus {
  ACTIVE
  REVOKED
  ARCHIVED
}

/// Short-lived, single-use linking token generated from an authenticated IMS
/// session. Only the SHA-256 hash is stored; the raw token is shown once in
/// the UI and redeemed by texting "LINK <token>" from WhatsApp. One ACTIVE
/// token per user at a time.
model WhatsAppLinkToken {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          String          @map("company_id") @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  tokenHash          String          @unique @map("token_hash")
  tokenVersion       String          @default("V1") @map("token_version")
  status             LinkTokenStatus @default(ACTIVE)
  expiresAt          DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt             DateTime?       @map("used_at") @db.Timestamptz(6)
  /// E.164 without "+"; set at redemption.
  linkedPhone        String?         @map("linked_phone")
  attemptCount       Int             @default(0) @map("attempt_count")
  generatedIp        String?         @map("generated_ip")
  generatedUserAgent String?         @map("generated_user_agent")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([companyId])
  @@map("whatsapp_link_tokens")
}

/// Permanent trusted-device record: a WhatsApp number proven (via link token)
/// to belong to a user. Revocation is soft (REVOKED/ARCHIVED) — history is
/// never deleted. A phone number has exactly one owner row globally.
model WhatsAppDevice {
  id          String               @id @default(uuid()) @db.Uuid
  companyId   String               @map("company_id") @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  /// E.164 without "+", as Meta sends it.
  phoneNumber String               @unique @map("phone_number")
  nickname    String?
  deviceType  String?              @map("device_type")
  status      WhatsAppDeviceStatus @default(ACTIVE)
  linkedAt    DateTime             @default(now()) @map("linked_at") @db.Timestamptz(6)
  lastSeenAt  DateTime?            @map("last_seen_at") @db.Timestamptz(6)
  revokedAt   DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokedById String?              @map("revoked_by_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedBy User?   @relation("WhatsAppDeviceRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([companyId])
  @@map("whatsapp_devices")
}

model Conversation {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @map("company_id") @db.Uuid
  userChannelLinkId String             @map("user_channel_link_id") @db.Uuid
  status            ConversationStatus @default(ACTIVE)
  /// Rolling summary for AI context hydration (Phase 2).
  summary           String?            @db.Text
  lastMessageAt     DateTime?          @map("last_message_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userChannelLink UserChannelLink @relation(fields: [userChannelLinkId], references: [id], onDelete: Cascade)
  messages        Message[]
  agentTasks      AgentTask[]

  @@index([companyId, lastMessageAt])
  @@index([userChannelLinkId, status])
  @@map("conversations")
}

model Message {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  direction      MessageDirection
  /// Provider message id (Meta `wamid...`) for dedupe + delivery status.
  waMessageId    String?           @map("wa_message_id")
  type           String            @default("text")
  body           String?           @db.Text
  /// Raw provider payload (inbound) or send request/response (outbound).
  payload        Json?
  status         ChatMessageStatus @default(RECEIVED)
  error          String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([waMessageId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Per-company AI configuration: provider, role→model mapping, flags, limits,
/// approval-policy thresholds, and the active versioned system prompt.
model AiSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @unique @map("company_id") @db.Uuid
  provider              String   @default("deepseek")
  intentModel           String?  @map("intent_model")
  reasoningModel        String?  @map("reasoning_model")
  escalationModel       String?  @map("escalation_model")
  featureFlags          Json     @default("{}") @map("feature_flags")
  dailyRequestLimit     Int?     @map("daily_request_limit")
  monthlyTokenLimit     Int?     @map("monthly_token_limit")
  monthlyCostCentsLimit Int?     @map("monthly_cost_cents_limit")
  approvalPolicy        Json     @default("{}") @map("approval_policy")
  promptVersion         Int      @default(0) @map("prompt_version")
  systemPrompt          String?  @map("system_prompt") @db.Text
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

model AiPromptHistory {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  version     Int
  body        String   @db.Text
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, version])
  @@map("ai_prompt_history")
}

/// One row per AI provider call: metering (tokens/cost) + observability
/// (tool timing, failures, escalation/handoff) — drives limits and metrics.
model AiUsageLog {
  id             String      @id @default(uuid()) @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  conversationId String?     @map("conversation_id") @db.Uuid
  model          String
  role           AiModelRole
  inputTokens    Int         @default(0) @map("input_tokens")
  outputTokens   Int         @default(0) @map("output_tokens")
  costCents      Int         @default(0) @map("cost_cents")
  toolDurationMs Int?        @map("tool_duration_ms")
  toolErrors     Int         @default(0) @map("tool_errors")
  toolCallCount  Int         @default(0) @map("tool_call_count")
  toolRounds     Int         @default(0) @map("tool_rounds")
  durationMs     Int?        @map("duration_ms")
  timedOut       Boolean     @default(false) @map("timed_out")
  escalated      Boolean     @default(false)
  humanHandoff   Boolean     @default(false) @map("human_handoff")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([conversationId])
  @@map("ai_usage_logs")
}



enum AgentTaskStatus {
  DRAFT
  WAITING_APPROVAL
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentTaskStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

/// Phase 3: a drafted business action awaiting approval and its execution
/// record. Business state lives here, NOT in the conversation — enables
/// "approve task #421", task lists, and audit. One task owns ordered steps;
/// a failed later step never invalidates an earlier completed one.
model AgentTask {
  id             String          @id @default(uuid()) @db.Uuid
  /// Human-friendly reference used in chat ("task #421"). Global sequence.
  taskNumber     Int             @unique @default(autoincrement()) @map("task_number")
  companyId      String          @map("company_id") @db.Uuid
  conversationId String          @map("conversation_id") @db.Uuid
  /// Linked user who asked for the action (executes with THEIR permissions).
  requestedById  String          @map("requested_by") @db.Uuid
  /// Registry action id, e.g. "purchase.create_po".
  type           String
  status         AgentTaskStatus @default(DRAFT)
  /// Validated service-layer payload (e.g. CreatePurchaseOrderDto shape).
  payload        Json
  /// Human-readable draft summary exactly as presented for approval.
  summary        String          @db.Text
  /// Execution result surfaced to chat (e.g. { poId, poNumber, totalValue }).
  result         Json?
  approvedById   String?         @map("approved_by") @db.Uuid
  approvedAt     DateTime?       @map("approved_at") @db.Timestamptz(6)
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz(6)
  failureReason  String?         @map("failure_reason")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestedBy  User          @relation("AgentTasksRequested", fields: [requestedById], references: [id], onDelete: Cascade)
  approvedBy   User?         @relation("AgentTasksApproved", fields: [approvedById], references: [id], onDelete: SetNull)
  steps        AgentTaskStep[]

  @@index([conversationId, status])
  @@index([companyId, createdAt])
  @@map("agent_tasks")
}

model AgentTaskStep {
  id          String              @id @default(uuid()) @db.Uuid
  taskId      String              @map("task_id") @db.Uuid
  /// 1-based execution order within the task.
  order       Int
  /// Step-runner name, e.g. "purchase.create_po".
  name        String
  status      AgentTaskStepStatus @default(PENDING)
  attempts    Int                 @default(0)
  result      Json?
  error       String?
  startedAt   DateTime?           @map("started_at") @db.Timestamptz(6)
  completedAt DateTime?           @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, order])
  @@map("agent_task_steps")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enterprise Event Platform — transactional outbox (Phase 1, Step 1)
// See docs/event-platform/. Producers emit domain events into this table INSIDE
// their business transaction; the relay publishes them to the in-process bus.
// ─────────────────────────────────────────────────────────────────────────────

enum EventClassification {
  AUTHENTICATION
  SECURITY
  FINANCIAL
  COMPLIANCE
  OPERATIONAL
  SYSTEM
  AI
  MARKETING
}

enum OutboxStatus {
  CREATED
  VALIDATED
  PENDING
  PUBLISHED
  ACKNOWLEDGED
  FAILED
  DEAD
  REPLAYED
}

model OutboxEvent {
  id             String              @id @default(uuid()) @db.Uuid
  /// Globally-unique idempotency key; consumers dedup on this.
  eventId        String              @unique @map("event_id") @db.Uuid
  eventType      String              @map("event_type")
  eventVersion   Int                 @map("event_version")
  aggregateType  String              @map("aggregate_type")
  aggregateId    String              @map("aggregate_id")
  companyId      String              @map("company_id") @db.Uuid
  classification EventClassification
  payload        Json
  correlationId  String              @map("correlation_id") @db.Uuid
  causationId    String?             @map("causation_id") @db.Uuid
  traceId        String?             @map("trace_id")
  spanId         String?             @map("span_id")
  actorId        String?             @map("actor_id") @db.Uuid
  status         OutboxStatus        @default(PENDING)
  retryCount     Int                 @default(0) @map("retry_count")
  lastError      String?             @map("last_error")
  nextAttemptAt  DateTime?           @map("next_attempt_at") @db.Timestamptz(6)
  publishedAt    DateTime?           @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([companyId])
  @@index([eventType, eventVersion])
  @@map("outbox_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification Engine — append-only delivery ledger (Phase 1, Step 2)
// See docs/event-platform/state-machines.md. One row per (event, recipient,
// channel, attempt); state advances forward only. Retries/fallbacks are new
// attempt rows. The unique key also provides send idempotency (at-least-once).
// ─────────────────────────────────────────────────────────────────────────────

enum DeliveryChannel {
  IN_APP
  WHATSAPP
  EMAIL
}

enum DeliveryState {
  CREATED
  QUEUED
  DISPATCHING
  SENT
  DELIVERED
  READ
  ACKNOWLEDGED
  FAILED
}

model NotificationDelivery {
  id                String              @id @default(uuid()) @db.Uuid
  /// Envelope eventId — idempotency + trace back to the source event.
  eventId           String              @map("event_id") @db.Uuid
  /// The in-app Notification row when channel = IN_APP (null for other channels).
  notificationId    String?             @map("notification_id") @db.Uuid
  companyId         String              @map("company_id") @db.Uuid
  recipientUserId   String              @map("recipient_user_id") @db.Uuid
  channel           DeliveryChannel
  attempt           Int                 @default(1)
  state             DeliveryState       @default(CREATED)
  classification    EventClassification
  providerMessageId String?             @map("provider_message_id")
  latencyMs         Int?                @map("latency_ms")
  slaSeconds        Int?                @map("sla_seconds")
  correlationId     String              @map("correlation_id") @db.Uuid
  error             String?
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([eventId, recipientUserId, channel, attempt])
  @@index([eventId])
  @@index([companyId, channel, state])
  @@index([recipientUserId, createdAt])
  @@map("notification_deliveries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification Engine — per-company overrides (Phase 1, Step 4)
// Rules/templates override the code defaults in notification-rules.ts. Absence
// of a row means "use the code default", so the engine always has a fallback.
// ─────────────────────────────────────────────────────────────────────────────

model NotificationRule {
  id             String              @id @default(uuid()) @db.Uuid
  companyId      String              @map("company_id") @db.Uuid
  eventType      String              @map("event_type")
  /// RoleName values (e.g. "OWNER"). Empty = fall back to the code default.
  recipientRoles String[]            @map("recipient_roles")
  channels       DeliveryChannel[]
  priority       NotificationPriority @default(NORMAL)
  slaSeconds     Int                 @map("sla_seconds")
  enabled        Boolean             @default(true)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, eventType])
  @@index([companyId])
  @@map("notification_rules")
}

model NotificationTemplate {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  eventType      String          @map("event_type")
  channel        DeliveryChannel
  // In-app overrides
  title          String?
  body           String?
  // Email overrides
  emailSubject   String?         @map("email_subject")
  emailBody      String?         @map("email_body")
  // WhatsApp overrides (per-tenant approved template + language)
  waTemplateName String?         @map("wa_template_name")
  waLanguage     String?         @map("wa_language")
  enabled        Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, eventType, channel])
  @@index([companyId])
  @@map("notification_templates")
}

// ─────────────────────────────────────────────────────────────────────────────
// Workflow / Notification Engine — explainability decision log (Phase 1, Step 4)
// One row per delivery decision recording *why*: the chosen channel, priority,
// outcome and reason. Append-only observability sidecar; the engine writes it
// best-effort and never lets a log failure break notification delivery.
// Written via guarded raw SQL today; typed model kept in sync for future use +
// drift detection.
// ─────────────────────────────────────────────────────────────────────────────

model WorkflowDecisionLog {
  id              String   @id @default(uuid()) @db.Uuid
  /// Envelope eventId — trace back to the source event.
  eventId         String   @map("event_id") @db.Uuid
  correlationId   String   @map("correlation_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  eventType       String   @map("event_type")
  /// Null for event-level decisions (e.g. NO_RECIPIENTS); set per recipient otherwise.
  recipientUserId String?  @map("recipient_user_id") @db.Uuid
  /// DeliveryChannel name, kept as text so the log is decoupled from the enum.
  channel         String
  /// NotificationPriority name at decision time.
  priority        String
  /// Reserved for numeric priority scoring (Phase 3).
  priorityScore   Int?     @map("priority_score")
  /// DELIVERED | SUPPRESSED_DUPLICATE | NO_RECIPIENTS | FAILED.
  outcome         String
  reason          String
  /// Which rule drove this (e.g. "code-default" or a NotificationRule id).
  matchedRule     String?  @map("matched_rule")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, createdAt])
  @@index([eventId])
  @@index([correlationId])
  @@map("workflow_decision_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Customer follow-up / dunning (Phase 2)
// Consent is required before any outbound customer message (WhatsApp policy +
// legal). FollowupThread is the durable dunning FSM state per invoice. States
// are stored as text (documented allowed values) so the models stay decoupled
// from generated Prisma enums and safe to add without a client regen.
// ─────────────────────────────────────────────────────────────────────────────

model CustomerContactChannel {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  /// WHATSAPP | EMAIL
  channel       String
  /// E.164 without "+" for WhatsApp, or an email address.
  address       String
  /// PENDING | OPTED_IN | OPTED_OUT
  consentState  String    @default("PENDING") @map("consent_state")
  consentAt     DateTime? @map("consent_at") @db.Timestamptz(6)
  lastEngagedAt DateTime? @map("last_engaged_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([customerId, channel])
  @@index([companyId, consentState])
  @@map("customer_contact_channels")
}

model FollowupThread {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  /// The dunned entity, e.g. "invoice".
  entityType      String    @map("entity_type")
  entityId        String    @map("entity_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  /// Highest completed ladder index; -1 = none yet.
  ladderStep      Int       @default(-1) @map("ladder_step")
  /// Reserved for the compiled WorkflowGraph node id (Phase 5).
  currentNodeId   String?   @map("current_node_id")
  /// Pins the workflow version a running thread executes.
  workflowVersion Int       @default(1) @map("workflow_version")
  /// ACTIVE | PAUSED | RESOLVED | ESCALATED | STOPPED | WAITING_APPROVAL
  state           String    @default("ACTIVE")
  nextActionAt    DateTime? @map("next_action_at") @db.Timestamptz(6)
  lastEventId     String?   @map("last_event_id") @db.Uuid
  stopReason      String?   @map("stop_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([entityType, entityId])
  @@index([companyId, state, nextActionAt])
  @@index([customerId])
  @@map("followup_threads")
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventory Health — Exception Engine + Health Score (Phase 2.5)
// ─────────────────────────────────────────────────────────────────────────────

model InventoryException {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  type             ExceptionType
  severity         ExceptionSeverity
  entityType       EntityType        @map("entity_type")
  entityId         String            @map("entity_id") @db.Uuid
  title            String
  description      String?
  status           ExceptionStatus   @default(OPEN)
  metadata         Json              @default("{}")

  firstDetectedAt  DateTime          @default(now()) @map("first_detected_at") @db.Timestamptz(6)
  lastDetectedAt   DateTime          @default(now()) @updatedAt @map("last_detected_at") @db.Timestamptz(6)

  acknowledgedAt   DateTime?         @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedBy   String?           @map("acknowledged_by") @db.Uuid

  resolvedAt       DateTime?         @map("resolved_at") @db.Timestamptz(6)
  resolvedBy       String?           @map("resolved_by") @db.Uuid
  resolutionType   ResolutionType?   @map("resolution_type")
  resolutionNotes  String?           @map("resolution_notes")

  @@unique([companyId, type, entityType, entityId, status])
  @@index([companyId, status, type])
  @@index([companyId, severity, status])
  @@index([companyId, lastDetectedAt])
  @@map("inventory_exceptions")
}

model CompanyHealthScoreConfig {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @unique @map("company_id") @db.Uuid

  /// JSON structure with schemaVersion and weight configuration
  config    Json   @default("{\"schemaVersion\": 1, \"weights\": {}}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("company_health_score_configs")
}
