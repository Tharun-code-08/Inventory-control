generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  SHOP_USER
  INVENTORY_MANAGER
}

enum DocumentStatus {
  DRAFT
  POSTED
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum TransactionType {
  OPENING
  GOODS_RECEIPT
  GOODS_ISSUE
  DAMAGE
  ADJUSTMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  POST
  EXPORT
}

enum CostingMethod {
  AVERAGE
  FIFO
}

enum FulfillmentStatus {
  NONE
  PARTIAL
  FULL
}

enum ReturnStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  VOID
}

model Company {
  id          String   @id @default(uuid()) @db.Uuid
  companyCode String   @unique @map("company_code")
  companyName String   @map("company_name")
  address     String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  shops     Shop[]
  suppliers Supplier[]

  @@map("companies")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  permissions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String? @map("updated_by") @db.Uuid
  users       User[]

  @@map("roles")
}

model Shop {
  id                  String        @id @default(uuid()) @db.Uuid
  shopNumber          String        @unique @map("shop_number")
  shopName            String        @map("shop_name")
  taxId               String?       @map("tax_id")
  address             String
  contactPerson       String        @map("contact_person")
  mobile              String
  email               String
  companyId           String?       @map("company_id") @db.Uuid
  isActive            Boolean       @default(true) @map("is_active")
  costingMethod       CostingMethod @default(AVERAGE) @map("costing_method")
  functionalCurrency  String        @default("USD") @map("functional_currency")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById         String?       @map("created_by") @db.Uuid
  updatedById         String?       @map("updated_by") @db.Uuid

  company             Company? @relation(fields: [companyId], references: [id])
  users               User[]
  productPlants       ProductPlant[]
  goodsReceipts       GoodsReceiptHeader[]
  goodsIssues         GoodsIssueHeader[]
  damagedStocks       DamagedStock[]
  purchaseOrders      PurchaseOrderHeader[]
  stockLedgers        StockLedger[]
  stockSummaries      StockSummary[]
  documentSequences   DocumentSequence[]
  storageLocations    StorageLocation[]
  rfqs                RfqHeader[]
  contracts           ContractHeader[]
  supplierQuotations  SupplierQuotationHeader[]
  customers           Customer[]
  salesOrders         SalesOrderHeader[]
  salesQuotations     SalesQuotationHeader[]
  invoiceHeaders      InvoiceHeader[]
  paymentReceipts     PaymentReceipt[]
  alertEvents         AlertEvent[]
  costLayers          CostLayer[]
  customerReturns     CustomerReturn[]
  supplierReturns     SupplierReturn[]
  creditNotes         CreditNote[]

  @@map("shops")
}

model StorageLocation {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  code        String   @map("code")
  name        String   @map("name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  shop Shop @relation(fields: [shopId], references: [id])
  productPlants ProductPlant[]

  @@unique([shopId, code])
  @@index([shopId, code])
  @@map("storage_locations")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  email              String    @unique
  passwordHash       String    @map("password_hash")
  avatarUrl          String?   @map("avatar_url")
  roleId             String    @map("role_id") @db.Uuid
  shopId             String?   @map("shop_id") @db.Uuid
  isActive           Boolean   @default(true) @map("is_active")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  refreshTokenHash   String?   @map("refresh_token_hash")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById        String?   @map("created_by") @db.Uuid
  updatedById        String?   @map("updated_by") @db.Uuid

  role Role @relation(fields: [roleId], references: [id])
  shop Shop? @relation(fields: [shopId], references: [id])

  auditLogs AuditLog[]
  sessions  Session[]

  @@index([deletedAt])
  @@map("users")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  refreshHash String    @map("refresh_hash")
  ip          String?
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  productCode       String   @unique @map("product_code")
  description       String
  uom               String
  category          String
  materialGroup     String?  @map("material_group")
  drawingReference  String?  @map("drawing_reference")
  purchasePrice     Decimal  @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice      Decimal  @map("selling_price") @db.Decimal(12, 2)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       String?  @map("created_by") @db.Uuid
  updatedById       String?  @map("updated_by") @db.Uuid

  plants                 ProductPlant[]
  specifications         ProductSpecification[]
  goodsReceiptItems      GoodsReceiptItem[]
  goodsIssueItems        GoodsIssueItem[]
  damagedStocks          DamagedStock[]
  purchaseOrderItems     PurchaseOrderItem[]
  stockLedgers           StockLedger[]
  stockSummaries         StockSummary[]
  rfqItems               RfqItem[]
  contractItems          ContractItem[]
  supplierQuotationItems SupplierQuotationItem[]
  salesOrderItems        SalesOrderItem[]
  salesQuotationItems    SalesQuotationItem[]
  costLayers             CostLayer[]
  customerReturnItems    CustomerReturnItem[]
  supplierReturnItems    SupplierReturnItem[]

  @@map("products")
}

model ProductPlant {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  shopId            String   @map("shop_id") @db.Uuid
  storageLocationId String?  @map("storage_location_id") @db.Uuid
  openingStock     Decimal  @default(0) @map("opening_stock") @db.Decimal(12, 3)
  minStockLevel    Decimal  @default(0) @map("min_stock_level") @db.Decimal(12, 3)
  maxStockLevel    Decimal? @map("max_stock_level") @db.Decimal(12, 3)
  reorderQty       Decimal? @map("reorder_qty") @db.Decimal(12, 3)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      String?  @map("created_by") @db.Uuid
  updatedById      String?  @map("updated_by") @db.Uuid

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop            Shop             @relation(fields: [shopId], references: [id])
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id])

  @@unique([productId, shopId])
  @@index([shopId])
  @@index([storageLocationId])
  @@map("product_plants")
}

model ProductSpecification {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  label     String
  value     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_specifications")
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  supplierCode  String   @unique @map("supplier_code")
  supplierName  String   @map("supplier_name")
  companyId     String?  @map("company_id") @db.Uuid
  taxId         String?  @map("tax_id")
  vatNumber     String?  @map("vat_number")
  rating        Int      @default(0)
  categories    String[] @default([])
  contactPerson String?  @map("contact_person")
  email         String?
  phone         String?
  street        String?
  city          String?
  state         String?
  postalCode    String?  @map("postal_code")
  country       String?
  paymentTerms  String?  @map("payment_terms")
  bankName      String?  @map("bank_name")
  accountNumber String?  @map("account_number")
  routingNumber String?  @map("routing_number")
  iban          String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById   String?  @map("created_by") @db.Uuid
  updatedById   String?  @map("updated_by") @db.Uuid

  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  company    Company?         @relation(fields: [companyId], references: [id])
  rfqLinks   RfqSupplier[]
  contracts  ContractHeader[]
  quotations SupplierQuotationHeader[]

  @@index([companyId])
  @@index([supplierName])
  @@index([deletedAt])
  @@map("suppliers")
}

model RfqHeader {
  id        String         @id @default(uuid()) @db.Uuid
  rfqNumber String         @unique @map("rfq_number")
  rfqDate   DateTime       @map("rfq_date") @db.Date
  deadline  DateTime?      @map("deadline") @db.Date
  title     String
  notes     String?
  shopId    String         @map("shop_id") @db.Uuid
  status    DocumentStatus @default(DRAFT)
  postedAt  DateTime?      @map("posted_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?      @map("created_by") @db.Uuid
  updatedById String?      @map("updated_by") @db.Uuid

  shop      Shop          @relation(fields: [shopId], references: [id])
  suppliers RfqSupplier[]
  items     RfqItem[]
  contracts ContractHeader[]
  quotations SupplierQuotationHeader[]

  @@index([shopId, rfqDate])
  @@map("rfq_header")
}

model RfqSupplier {
  id         String @id @default(uuid()) @db.Uuid
  rfqId      String @map("rfq_id") @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rfq      RfqHeader @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier Supplier  @relation(fields: [supplierId], references: [id])

  @@unique([rfqId, supplierId])
  @@index([supplierId])
  @@map("rfq_suppliers")
}

model RfqItem {
  id             String   @id @default(uuid()) @db.Uuid
  rfqHeaderId    String   @map("rfq_header_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  description    String?
  quantity       Decimal  @db.Decimal(12, 3)
  uom            String
  specifications String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String?  @map("created_by") @db.Uuid
  updatedById    String?  @map("updated_by") @db.Uuid

  header  RfqHeader @relation(fields: [rfqHeaderId], references: [id], onDelete: Cascade)
  product Product?  @relation(fields: [productId], references: [id])
  quotationItems SupplierQuotationItem[]

  @@index([rfqHeaderId])
  @@map("rfq_items")
}

model ContractHeader {
  id             String         @id @default(uuid()) @db.Uuid
  contractNumber String         @unique @map("contract_number")
  shopId         String         @map("shop_id") @db.Uuid
  supplierId     String         @map("supplier_id") @db.Uuid
  rfqId          String?        @map("rfq_id") @db.Uuid
  quotationId    String?        @map("quotation_id") @db.Uuid
  title          String
  paymentTerms   String?        @map("payment_terms")
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime?      @map("end_date") @db.Date
  notes          String?
  status         DocumentStatus @default(DRAFT)
  postedAt       DateTime?      @map("posted_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String?        @map("created_by") @db.Uuid
  updatedById    String?        @map("updated_by") @db.Uuid

  shop        Shop                     @relation(fields: [shopId], references: [id])
  supplier    Supplier                 @relation(fields: [supplierId], references: [id])
  rfq         RfqHeader?               @relation(fields: [rfqId], references: [id])
  quotation   SupplierQuotationHeader? @relation(fields: [quotationId], references: [id])
  items       ContractItem[]
  purchaseOrders PurchaseOrderHeader[]

  @@index([shopId, startDate])
  @@index([supplierId])
  @@map("contract_header")
}

model ContractItem {
  id           String   @id @default(uuid()) @db.Uuid
  contractId   String   @map("contract_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  description  String?
  quantity     Decimal  @db.Decimal(12, 3)
  uom          String
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineValue    Decimal  @map("line_value") @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?  @map("created_by") @db.Uuid
  updatedById  String?  @map("updated_by") @db.Uuid

  header  ContractHeader @relation(fields: [contractId], references: [id], onDelete: Cascade)
  product Product?       @relation(fields: [productId], references: [id])

  @@index([contractId])
  @@map("contract_items")
}

model SupplierQuotationHeader {
  id          String         @id @default(uuid()) @db.Uuid
  quoteNumber String         @unique @map("quote_number")
  quoteDate   DateTime       @map("quote_date") @db.Date
  shopId      String         @map("shop_id") @db.Uuid
  rfqId       String         @map("rfq_id") @db.Uuid
  supplierId  String         @map("supplier_id") @db.Uuid
  notes       String?
  status      DocumentStatus @default(DRAFT)
  postedAt    DateTime?      @map("posted_at") @db.Timestamptz(6)
  totalValue  Decimal?       @map("total_value") @db.Decimal(14, 2)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?        @map("created_by") @db.Uuid
  updatedById String?        @map("updated_by") @db.Uuid

  shop     Shop      @relation(fields: [shopId], references: [id])
  rfq      RfqHeader @relation(fields: [rfqId], references: [id])
  supplier Supplier  @relation(fields: [supplierId], references: [id])
  items    SupplierQuotationItem[]
  contracts ContractHeader[]

  @@index([shopId, quoteDate])
  @@index([rfqId, supplierId])
  @@map("supplier_quote_header")
}

model SupplierQuotationItem {
  id            String   @id @default(uuid()) @db.Uuid
  quoteHeaderId String   @map("quote_header_id") @db.Uuid
  rfqItemId     String?  @map("rfq_item_id") @db.Uuid
  productId     String?  @map("product_id") @db.Uuid
  description   String?
  quantity      Decimal  @db.Decimal(12, 3)
  uom           String
  specifications String?
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineValue     Decimal  @map("line_value") @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById   String?  @map("created_by") @db.Uuid
  updatedById   String?  @map("updated_by") @db.Uuid

  header  SupplierQuotationHeader @relation(fields: [quoteHeaderId], references: [id], onDelete: Cascade)
  rfqItem RfqItem?                @relation(fields: [rfqItemId], references: [id])
  product Product?                @relation(fields: [productId], references: [id])

  @@index([quoteHeaderId])
  @@index([rfqItemId])
  @@map("supplier_quote_items")
}

model GoodsReceiptHeader {
  id            String         @id @default(uuid()) @db.Uuid
  grNumber      String         @unique @map("gr_number")
  grDate        DateTime       @map("gr_date") @db.Date
  shopId        String         @map("shop_id") @db.Uuid
  supplierName  String         @map("supplier_name")
  purchaseOrderId String?      @map("purchase_order_id") @db.Uuid
  supplierRef   String?        @map("supplier_ref")
  remarks       String?
  status        DocumentStatus @default(DRAFT)
  postedAt      DateTime?      @map("posted_at") @db.Timestamptz(6)
  totalValue    Decimal?       @map("total_value") @db.Decimal(14, 2)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById   String?        @map("created_by") @db.Uuid
  updatedById   String?        @map("updated_by") @db.Uuid

  shop          Shop                 @relation(fields: [shopId], references: [id])
  purchaseOrder PurchaseOrderHeader? @relation(fields: [purchaseOrderId], references: [id])
  items         GoodsReceiptItem[]

  @@index([shopId, grDate])
  @@index([shopId, status, grDate])
  @@index([purchaseOrderId])
  @@map("goods_receipt_header")
}

model GoodsReceiptItem {
  id           String   @id @default(uuid()) @db.Uuid
  grHeaderId   String   @map("gr_header_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  quantity     Decimal  @db.Decimal(12, 3)
  uom          String
  purchaseRate Decimal  @map("purchase_rate") @db.Decimal(12, 2)
  lineValue    Decimal  @map("line_value") @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?  @map("created_by") @db.Uuid
  updatedById  String?  @map("updated_by") @db.Uuid

  header  GoodsReceiptHeader @relation(fields: [grHeaderId], references: [id], onDelete: Cascade)
  product Product            @relation(fields: [productId], references: [id])

  @@index([grHeaderId])
  @@index([productId])
  @@map("goods_receipt_items")
}

model GoodsIssueHeader {
  id           String         @id @default(uuid()) @db.Uuid
  giNumber     String         @unique @map("gi_number")
  giDate       DateTime       @map("gi_date") @db.Date
  shopId       String         @map("shop_id") @db.Uuid
  issueReason  String         @map("issue_reason")
  remarks      String?
  status       DocumentStatus @default(DRAFT)
  postedAt     DateTime?      @map("posted_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?        @map("created_by") @db.Uuid
  updatedById  String?        @map("updated_by") @db.Uuid

  shop  Shop @relation(fields: [shopId], references: [id])
  items GoodsIssueItem[]

  @@index([shopId, giDate])
  @@index([shopId, status, giDate])
  @@map("goods_issue_header")
}

model GoodsIssueItem {
  id                      String   @id @default(uuid()) @db.Uuid
  giHeaderId              String   @map("gi_header_id") @db.Uuid
  productId               String   @map("product_id") @db.Uuid
  quantity                Decimal  @db.Decimal(12, 3)
  uom                     String
  availableStockSnapshot  Decimal  @map("available_stock_snapshot") @db.Decimal(12, 3)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById             String?  @map("created_by") @db.Uuid
  updatedById             String?  @map("updated_by") @db.Uuid

  header  GoodsIssueHeader @relation(fields: [giHeaderId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id])

  @@index([giHeaderId])
  @@index([productId])
  @@map("goods_issue_items")
}

model DamagedStock {
  id               String         @id @default(uuid()) @db.Uuid
  damageNumber     String         @unique @map("damage_number")
  damageDate       DateTime       @map("damage_date") @db.Date
  shopId           String         @map("shop_id") @db.Uuid
  productId        String         @map("product_id") @db.Uuid
  damagedQuantity  Decimal        @map("damaged_quantity") @db.Decimal(12, 3)
  reason           String
  remarks          String?
  status           DocumentStatus @default(DRAFT)
  postedAt         DateTime?      @map("posted_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      String?        @map("created_by") @db.Uuid
  updatedById      String?        @map("updated_by") @db.Uuid

  shop    Shop    @relation(fields: [shopId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([shopId, damageDate])
  @@index([shopId, productId])
  @@index([status, damageDate])
  @@map("damaged_stock")
}

model PurchaseOrderHeader {
  id              String                @id @default(uuid()) @db.Uuid
  poNumber        String                @unique @map("po_number")
  poDate          DateTime              @map("po_date") @db.Date
  shopId          String                @map("shop_id") @db.Uuid
  contractId      String?               @map("contract_id") @db.Uuid
