  returnId         String   @map("return_id") @db.Uuid
  returnItemId     String?  @map("return_item_id") @db.Uuid
  filePath         String   @map("file_path")
  publicUrl        String   @map("public_url")
  originalFilename String   @map("original_filename")
  mimeType         String   @map("mime_type")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      String?  @map("created_by") @db.Uuid

  header SupplierReturn      @relation(fields: [returnId], references: [id], onDelete: Cascade)
  item   SupplierReturnItem? @relation(fields: [returnItemId], references: [id], onDelete: SetNull)

  @@index([returnId])
  @@index([returnItemId])
  @@map("supplier_return_images")
}

model CreditNote {
  id           String           @id @default(uuid()) @db.Uuid
  creditNumber String           @unique @map("credit_number")
  creditDate   DateTime         @map("credit_date") @db.Date
  shopId       String           @map("shop_id") @db.Uuid
  customerId   String           @map("customer_id") @db.Uuid
  invoiceId    String?          @map("invoice_id") @db.Uuid
  returnId     String?          @unique @map("return_id") @db.Uuid
  status       CreditNoteStatus @default(DRAFT)
  amount       Decimal          @db.Decimal(14, 2)
  appliedAmt   Decimal          @default(0) @map("applied_amount") @db.Decimal(14, 2)
  remarks      String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?          @map("created_by") @db.Uuid
  updatedById  String?          @map("updated_by") @db.Uuid

  shop     Shop            @relation(fields: [shopId], references: [id])
  customer Customer        @relation(fields: [customerId], references: [id])
  invoice  InvoiceHeader?  @relation(fields: [invoiceId], references: [id])
  return   CustomerReturn? @relation(fields: [returnId], references: [id])

  @@index([shopId, creditDate])
  @@index([customerId])
  @@map("credit_notes")
}

model PoCancelVerification {
  id           String    @id @default(uuid()) @db.Uuid
  poId         String    @map("po_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  reason       String
  otpHash      String    @map("otp_hash")
  attemptCount Int       @default(0) @map("attempt_count")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  po PurchaseOrderHeader @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId, userId])
  @@index([expiresAt])
  @@map("po_cancel_verifications")
}

model SupplierBillHeader {
  id               String             @id @default(uuid()) @db.Uuid
  billNumber       String             @unique @map("bill_number")
  billDate         DateTime           @map("bill_date") @db.Date
  dueDate          DateTime?          @map("due_date") @db.Date
  shopId           String             @map("shop_id") @db.Uuid
  supplierId       String             @map("supplier_id") @db.Uuid
  purchaseOrderId  String?            @map("purchase_order_id") @db.Uuid
  goodsReceiptId   String?            @map("goods_receipt_id") @db.Uuid
  status           SupplierBillStatus @default(DRAFT)
  brandingMode     BrandingMode       @default(SNAPSHOT) @map("branding_mode")
  brandingSnapshot Json?              @map("branding_snapshot")
  templateVersion  Int                @default(1) @map("template_version")
  totalValue       Decimal            @map("total_value") @db.Decimal(14, 2)
  paidValue        Decimal            @default(0) @map("paid_value") @db.Decimal(14, 2)
  remarks          String?
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      String?            @map("created_by") @db.Uuid
  updatedById      String?            @map("updated_by") @db.Uuid

  shop          Shop                 @relation(fields: [shopId], references: [id])
  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrderHeader? @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt  GoodsReceiptHeader?  @relation(fields: [goodsReceiptId], references: [id])
  items         SupplierBillItem[]
  payments      SupplierPayment[]

  @@index([shopId, billDate])
  @@index([shopId, status, billDate])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([goodsReceiptId])
  @@map("supplier_bill_header")
}

model SupplierBillItem {
  id           String  @id @default(uuid()) @db.Uuid
  billHeaderId String  @map("bill_header_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  quantity     Decimal @db.Decimal(12, 3)
  uom          String
  unitCost     Decimal @map("unit_cost") @db.Decimal(12, 2)
  lineValue    Decimal @map("line_value") @db.Decimal(14, 2)

  header  SupplierBillHeader @relation(fields: [billHeaderId], references: [id], onDelete: Cascade)
  product Product            @relation(fields: [productId], references: [id])

  @@index([billHeaderId])
  @@map("supplier_bill_items")
}

model SupplierPayment {
  id               String       @id @default(uuid()) @db.Uuid
  paymentNumber    String       @unique @map("payment_number")
  paymentDate      DateTime     @map("payment_date") @db.Date
  supplierBillId   String       @map("supplier_bill_id") @db.Uuid
  shopId           String       @map("shop_id") @db.Uuid
  amount           Decimal      @db.Decimal(14, 2)
  method           String?
  reference        String?
  remarks          String?
  brandingMode     BrandingMode @default(SNAPSHOT) @map("branding_mode")
  brandingSnapshot Json?        @map("branding_snapshot")
  templateVersion  Int          @default(1) @map("template_version")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      String?      @map("created_by") @db.Uuid
  updatedById      String?      @map("updated_by") @db.Uuid

  supplierBill SupplierBillHeader @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)
  shop         Shop               @relation(fields: [shopId], references: [id])

  @@index([shopId, paymentDate])
  @@index([supplierBillId])
  @@map("supplier_payments")
}

model StockTransferHeader {
  id                    String         @id @default(uuid()) @db.Uuid
  transferNumber        String         @unique @map("transfer_number")
  transferDate          DateTime       @map("transfer_date") @db.Date
  fromShopId            String         @map("from_shop_id") @db.Uuid
  toShopId              String         @map("to_shop_id") @db.Uuid
  fromStorageLocationId String?        @map("from_storage_location_id") @db.Uuid
  toStorageLocationId   String?        @map("to_storage_location_id") @db.Uuid
  status                DocumentStatus @default(DRAFT)
  notes                 String?
  createdVia            StockTransferCreatedVia @default(MANUAL) @map("created_via")
  dispatchedAt          DateTime?      @map("dispatched_at") @db.Timestamptz(6)
  receivedAt            DateTime?      @map("received_at") @db.Timestamptz(6)
  dispatchedById        String?        @map("dispatched_by") @db.Uuid
  receivedById          String?        @map("received_by") @db.Uuid
  postedAt              DateTime?      @map("posted_at") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById           String?        @map("created_by") @db.Uuid
  updatedById           String?        @map("updated_by") @db.Uuid

  fromShop            Shop                        @relation("StockTransferFromShop", fields: [fromShopId], references: [id])
  toShop              Shop                        @relation("StockTransferToShop", fields: [toShopId], references: [id])
  fromStorageLocation StorageLocation?            @relation("StockTransferFromLocation", fields: [fromStorageLocationId], references: [id])
  toStorageLocation   StorageLocation?            @relation("StockTransferToLocation", fields: [toStorageLocationId], references: [id])
  items               StockTransferItem[]
  statusHistory       StockTransferStatusHistory[]

  @@index([fromShopId, transferDate])
  @@index([toShopId, transferDate])
  @@index([status])
  @@map("stock_transfer_header")
}

model StockTransferItem {
  id         String  @id @default(uuid()) @db.Uuid
  transferId String  @map("transfer_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Decimal @db.Decimal(12, 3)
  uom        String

  header StockTransferHeader     @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product Product                @relation(fields: [productId], references: [id])
  lots    StockTransferItemLot[]

  @@index([transferId])
  @@map("stock_transfer_items")
}

model InventoryLot {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @map("company_id") @db.Uuid
  shopId            String             @map("shop_id") @db.Uuid
  productId         String             @map("product_id") @db.Uuid
  lotNumber         String             @map("lot_number")
  expiryDate        DateTime?          @map("expiry_date") @db.Date
  qtyReceived       Decimal            @default(0) @map("qty_received") @db.Decimal(12, 3)
  qtyOnHand         Decimal            @default(0) @map("qty_on_hand") @db.Decimal(12, 3)
  unitCost          Decimal?           @map("unit_cost") @db.Decimal(14, 4)
  status            InventoryLotStatus @default(ACTIVE)
  storageLocationId String?            @map("storage_location_id") @db.Uuid
  grItemId          String?            @map("gr_item_id") @db.Uuid
  blockedAt         DateTime?          @map("blocked_at") @db.Timestamptz(6)
  blockedReason     String?            @map("blocked_reason")
  scrappedAt        DateTime?          @map("scrapped_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       String?            @map("created_by") @db.Uuid
  updatedById       String?            @map("updated_by") @db.Uuid

  shop            Shop                 @relation(fields: [shopId], references: [id])
  product         Product              @relation(fields: [productId], references: [id])
  storageLocation StorageLocation?     @relation(fields: [storageLocationId], references: [id])
  grItem          GoodsReceiptItem?    @relation(fields: [grItemId], references: [id])
  issueAllocations    GoodsIssueItemLot[]
  transferAllocations StockTransferItemLot[]
  alerts              InventoryLotAlert[]

  @@unique([shopId, productId, lotNumber])
  @@index([shopId, productId, status, expiryDate])
  @@index([companyId, status, expiryDate])
  @@map("inventory_lots")
}

model GoodsIssueItemLot {
  id       String  @id @default(uuid()) @db.Uuid
  giItemId String  @map("gi_item_id") @db.Uuid
  lotId    String  @map("lot_id") @db.Uuid
  quantity Decimal @db.Decimal(12, 3)

  item GoodsIssueItem @relation(fields: [giItemId], references: [id], onDelete: Cascade)
  lot  InventoryLot   @relation(fields: [lotId], references: [id])

  @@unique([giItemId, lotId])
  @@index([lotId])
  @@map("goods_issue_item_lots")
}

model StockTransferItemLot {
  id             String  @id @default(uuid()) @db.Uuid
  transferItemId String  @map("transfer_item_id") @db.Uuid
  lotId          String  @map("lot_id") @db.Uuid
  quantity       Decimal @db.Decimal(12, 3)

  item StockTransferItem @relation(fields: [transferItemId], references: [id], onDelete: Cascade)
  lot  InventoryLot      @relation(fields: [lotId], references: [id])

  @@unique([transferItemId, lotId])
  @@index([lotId])
  @@map("stock_transfer_item_lots")
}

model StockTransferStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  transferId String         @map("transfer_id") @db.Uuid
  fromStatus DocumentStatus? @map("from_status")
  toStatus   DocumentStatus  @map("to_status")
  changedById String?        @map("changed_by") @db.Uuid
  changedAt  DateTime       @default(now()) @map("changed_at") @db.Timestamptz(6)
  remarks    String?

  header StockTransferHeader @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId, changedAt])
  @@map("stock_transfer_status_history")
}

model InventoryLotAlert {
  id        String   @id @default(uuid()) @db.Uuid
  lotId     String   @map("lot_id") @db.Uuid
  threshold Int
  eventId   String   @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lot InventoryLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([lotId, threshold])
  @@map("inventory_lot_alerts")
}

enum BackupProvider {
  MANUAL
  GOOGLE_DRIVE
  EMAIL
}

enum BackupJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum RestoreJobStatus {
  PENDING
  DRY_RUN_COMPLETED
  RUNNING
  COMPLETED
  FAILED
}

enum RestoreMode {
  TENANT_REPLACE
  FULL_DB
}

model BackupProviderCredential {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  provider        BackupProvider @default(GOOGLE_DRIVE)
  encryptedTokens String         @map("encrypted_tokens")
  accountEmail    String?        @map("account_email")
  driveFolderId   String?        @map("drive_folder_id")
  connectedAt     DateTime       @default(now()) @map("connected_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@map("backup_provider_credentials")
}

model BackupArtifact {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  backupJobId   String?        @unique @map("backup_job_id") @db.Uuid
  fileName      String         @map("file_name")
  storagePath   String         @map("storage_path")
  fileSize      BigInt         @map("file_size")
  sha256        String
  provider      BackupProvider
  driveFileId   String?        @map("drive_file_id")
  schemaVersion Int            @default(1) @map("schema_version")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  backupJob   BackupJob?   @relation(fields: [backupJobId], references: [id], onDelete: SetNull)
  restoreJobs RestoreJob[]

  @@index([companyId, createdAt])
  @@map("backup_artifacts")
}

model BackupJob {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  status          BackupJobStatus @default(PENDING)
  provider        BackupProvider
  errorMessage    String?         @map("error_message")
  startedAt       DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdById     String?         @map("created_by") @db.Uuid
  lifecycleStatus LifecycleStatus @default(ACTIVE) @map("lifecycle_status")
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?         @map("deleted_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  artifact BackupArtifact?

  @@index([companyId, createdAt])
  @@map("backup_jobs")
}

model RestoreJob {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  artifactId        String           @map("artifact_id") @db.Uuid
  mode              RestoreMode      @default(TENANT_REPLACE)
  status            RestoreJobStatus @default(PENDING)
  dryRunReport      Json?            @map("dry_run_report")
  confirmationToken String?          @map("confirmation_token")
  errorMessage      String?          @map("error_message")
  startedAt         DateTime?        @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdById       String?          @map("created_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  artifact BackupArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("restore_jobs")
}

model CompanySetting {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  key       String   @map("key")
  value     String   @map("value")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
  @@map("company_settings")
}

model BarcodeAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  barcodeId  String?  @map("barcode_id") @db.Uuid
  barcode    String
  productId  String?  @map("product_id") @db.Uuid
  action     String   @map("action")
  detail     Json?
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([barcodeId])
  @@index([productId])
  @@map("barcode_audit_logs")
}

model BarcodeHistory {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  barcode      String
  oldProductId String?  @map("old_product_id") @db.Uuid
  newProductId String?  @map("new_product_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([barcode])
  @@map("barcode_history")
}

// ===== Sprint 3: notifications & approval workflow =====

enum NotificationPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum NotificationStatus {
  UNREAD
  READ
  DELETED
}

enum NotificationModule {
  GOODS_RECEIPT
  PURCHASE_ORDER
  RFQ
  SALES_QUOTATION
  WAREHOUSE_TRANSFER
  INVENTORY
  SECURITY
  SYSTEM
  APPROVAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  GOODS_RECEIPT
  PURCHASE_ORDER
  RFQ
  SALES_QUOTATION
  WAREHOUSE_TRANSFER
  INVENTORY_ADJUSTMENT
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

model Notification {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  companyId        String                 @map("company_id") @db.Uuid
  title            String
  message          String
  type             AlertType              @map("type")
  priority         NotificationPriority   @default(NORMAL)
  module           NotificationModule     @map("module")
  status           NotificationStatus     @default(UNREAD)
  referenceType    String?                @map("reference_type")
  referenceId      String?                @map("reference_id")
  deepLink         String?                @map("deep_link")
  actionUrl        String?                @map("action_url")
  isRead           Boolean                @default(false) @map("is_read")
  readAt           DateTime?              @map("read_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime?              @map("expires_at") @db.Timestamptz(6)
  createdById      String?                @map("created_by") @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([companyId, createdAt])
  @@index([type, priority])
  @@index([isRead, expiresAt])
  @@map("notifications")
}

model DeviceRegistration {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  companyId    String         @map("company_id") @db.Uuid
  deviceId     String         @map("device_id")
  deviceName   String?        @map("device_name")
  platform     DevicePlatform @map("platform")
  pushToken    String?        @map("push_token")
  appVersion   String?        @map("app_version")
  osVersion    String?        @map("os_version")
  isActive     Boolean        @default(true) @map("is_active")
  lastActiveAt DateTime       @default(now()) @map("last_active_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([companyId, platform])
  @@index([isActive, lastActiveAt])
  @@map("device_registrations")
}

model NotificationPreference {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  grCreated           Boolean   @default(true) @map("gr_created")
  grApproved          Boolean   @default(true) @map("gr_approved")
  grRejected          Boolean   @default(true) @map("gr_rejected")
  poApprovalRequired  Boolean   @default(true) @map("po_approval_required")
  poApproved          Boolean   @default(true) @map("po_approved")
  poRejected          Boolean   @default(true) @map("po_rejected")
  lowStockAlert       Boolean   @default(true) @map("low_stock_alert")
  transferCompleted   Boolean   @default(true) @map("transfer_completed")
  inventoryAdjustment Boolean   @default(true) @map("inventory_adjustment")
  loginAlert          Boolean   @default(true) @map("login_alert")
  deviceAlert         Boolean   @default(true) @map("device_alert")
  pushEnabled         Boolean   @default(true) @map("push_enabled")
  emailEnabled        Boolean   @default(false) @map("email_enabled")
  whatsappEnabled     Boolean   @default(false) @map("whatsapp_enabled")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("notification_preferences")
}

model ApprovalRequest {
  id               String           @id @default(uuid()) @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  requestedBy      String           @map("requested_by") @db.Uuid
  assignedTo       String           @map("assigned_to") @db.Uuid
  approvalType     ApprovalType     @map("approval_type")
  referenceId      String           @map("reference_id")
  status           ApprovalStatus   @default(PENDING)
  documentNumber   String?          @map("document_number")
  amount           Decimal?         @db.Decimal(14, 2)
  description      String?
  rejectionReason  String?          @map("rejection_reason")
  approvedAt       DateTime?        @map("approved_at") @db.Timestamptz(6)
  rejectedAt       DateTime?        @map("rejected_at") @db.Timestamptz(6)
  requiredAt       DateTime?        @map("required_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requester      User                @relation("ApprovalRequestsCreated", fields: [requestedBy], references: [id])
  approver       User                @relation("ApprovalRequestsAssigned", fields: [assignedTo], references: [id])
  comments       ApprovalComment[]
  escalations    ApprovalEscalation[]

  @@index([companyId, status, createdAt])
  @@index([assignedTo, status])
  @@index([approvalType, referenceId])
  @@map("approval_requests")
}

model ApprovalComment {
  id              String    @id @default(uuid()) @db.Uuid
  approvalId      String    @map("approval_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  comment         String
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  approval ApprovalRequest @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id])

  @@index([approvalId])
  @@map("approval_comments")
}

model ApprovalEscalation {
  id              String    @id @default(uuid()) @db.Uuid
  approvalId      String    @map("approval_id") @db.Uuid
  escalatedTo     String    @map("escalated_to") @db.Uuid
  escalatedAt     DateTime  @default(now()) @map("escalated_at") @db.Timestamptz(6)
  level           Int       @default(1)
  reason          String?
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)

  approval ApprovalRequest @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [escalatedTo], references: [id])

  @@index([approvalId, escalatedAt])
  @@map("approval_escalations")
}

model NotificationAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  action        String   @map("action")
  notificationId String? @map("notification_id") @db.Uuid
  approvalId    String?  @map("approval_id") @db.Uuid
  details       Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId, action, createdAt])
  @@index([userId, action])
  @@map("notification_audit_logs")
}

// ============================================
// DEVICE MANAGEMENT
// ============================================

model UserDevice {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  deviceId      String    @unique @map("device_id")
  deviceName    String    @map("device_name")
  platform      String    // "iOS", "Android", "Web"
  osVersion     String?   @map("os_version")
  lastLoginAt   DateTime  @default(now()) @map("last_login_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, revokedAt])
  @@index([companyId, createdAt])
  @@map("user_devices")
}

// ============================================
// PUSH NOTIFICATIONS
// ============================================

model NotificationSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  pushToken String   @map("push_token")
  platform  String   // "ios", "android", "web"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, pushToken])
  @@index([companyId, platform, isActive])
  @@index([userId])
  @@map("notification_subscriptions")
}

// ============================================
// COMPREHENSIVE AUDIT LOGGING
// ============================================

model AuditLog {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String?      @map("company_id") @db.Uuid
  userId       String?      @map("user_id") @db.Uuid
  action       AuditAction
  entityType   String?      @map("entity_type")
  entityId     String?      @map("entity_id")
  oldValues    Json?        @map("old_values")
  newValues    Json?        @map("new_values")
  ipAddress    String?      @map("ip_address")
  userAgent    String?      @map("user_agent") @db.Text
  deviceId     String?      @map("device_id")
  metadata     Json?
  reason       String?      // Flexible string instead of enum for easier evolution
  severity     AuditSeverity?
  requestId    String?      @map("request_id")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])

  @@index([companyId, action, createdAt])
  @@index([userId, createdAt])
  @@index([reason, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([companyId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

// ============================================
// LOW STOCK ALERTS
// ============================================

model LowStockAlert {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  shopId       String    @map("shop_id") @db.Uuid
  currentStock Int       @map("current_stock")
  minStock     Int       @map("min_stock")
  reorderPoint Int       @map("reorder_point")
  alertLevel   String    // "WARNING", "CRITICAL", "EMERGENCY"
  notified     Boolean   @default(false)
  notifiedAt   DateTime? @map("notified_at") @db.Timestamptz(6)
  resolved     Boolean   @default(false)
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
