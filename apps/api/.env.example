# API — copy to .env in this folder:
#   cp .env.example .env   (from apps/api)
NODE_ENV=development
API_PORT=3000
# Docker Postgres (from docker/docker-compose.yml)
DATABASE_URL=postgresql://retail:retail@localhost:5433/retail_ims

# Secrets must be high-entropy strings (>= 32 chars). Use distinct values for each.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_me_with_a_random_string_of_at_least_32_chars
REFRESH_SECRET=replace_me_with_a_DIFFERENT_random_string_at_least_32_chars
# Optional: secret for signing http-only cookies (refresh cookie). Recommended in production.
COOKIE_SECRET=replace_me_with_a_third_random_string_at_least_32_chars

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
REFRESH_COOKIE_NAME=refreshToken
# Bcrypt cost factor for password and refresh-id hashing. 12 is the recommended default.
BCRYPT_ROUNDS=12

# Comma-separated; include every origin you open the SPA from (Vite may bump port if 5200 is busy).
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5200,http://127.0.0.1:5200,http://localhost:5201,http://127.0.0.1:5201
# Optional for cross-domain tunnels/proxies (must be 'none' to allow cross-site refresh cookies)
# AUTH_COOKIE_SAME_SITE=none
# Allow https://*.trycloudflare.com origins. Default false. Set true ONLY for ad-hoc tunnel demos.
# ALLOW_TUNNEL_ORIGINS=true

# Rate limit windows (seconds) and request budgets per window (per IP).
RATE_LIMIT_AUTH_TTL=60
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_GLOBAL_TTL=60
RATE_LIMIT_GLOBAL_LIMIT=120

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
EXPORT_STORAGE_DIR=./storage/exports

# Outbound email — office@softdigitconsulting.com (Zoho Mail India)
# 1. Zoho Mail → Settings → Security → Application-Specific Passwords → app name "retail-ims"
# 2. Zoho Admin → Email Authentication: add SPF, DKIM, DMARC in Cloudflare DNS (required for Outlook/Gmail delivery)
#    SPF TXT @: v=spf1 include:zoho.in ~all
#    DKIM TXT: copy selector from Zoho (e.g. zoho._domainkey)
#    DMARC TXT _dmarc: v=DMARC1; p=none; rua=mailto:office@softdigitconsulting.com
# 3. If Outlook rejects with S3150, ask Zoho support to delist IP via https://sender.office.com
MAIL_FROM=office@softdigitconsulting.com
MAIL_REPLY_TO=office@softdigitconsulting.com
ADMIN_NOTIFICATION_EMAIL=office@softdigitconsulting.com
PUBLIC_WEB_URL=http://localhost:5173
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=office@softdigitconsulting.com
SMTP_PASS=your-zoho-app-password-for-retail-ims

# When true, error responses include stack traces. Defaults to false. Never enable in production.
APP_DEBUG=false

RAZORPAY_KEY_ID=rzp_test_St7HzbwAW940BN
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Demo: Plus at ₹5 for live demos. Remove to restore ₹599 monthly / ₹549 yearly.
# BILLING_DEMO_PLUS_PRICE_INR=5

# Web only — optional Payment Links (see apps/web/.env):
# VITE_RAZORPAY_PRO_PAYMENT_LINK=https://rzp.io/rzp/your-pro-link
# VITE_RAZORPAY_PLUS_PAYMENT_LINK=https://rzp.io/rzp/your-plus-link
