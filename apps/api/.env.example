# API — copy to .env in this folder:
#   cp .env.example .env   (from apps/api)
NODE_ENV=development
API_PORT=3000
# Docker Postgres (from docker/docker-compose.yml)
DATABASE_URL=postgresql://retail:retail@localhost:5433/retail_ims
JWT_SECRET=change_me_minimum_16_chars
REFRESH_SECRET=change_me_refresh_16
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
REFRESH_COOKIE_NAME=refreshToken
# Comma-separated; include every origin you open the SPA from (Vite may bump port if 5200 is busy).
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5200,http://127.0.0.1:5200,http://localhost:5201,http://127.0.0.1:5201
# Optional for cross-domain tunnels/proxies:
# AUTH_COOKIE_SAME_SITE=none
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
EXPORT_STORAGE_DIR=./storage/exports
